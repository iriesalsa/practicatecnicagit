{
  "appId": "com.bdsdevs.practicatecnica",
  "appName": "pracTICAtecnica",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "cleartext": false,
    "allowNavigation": [
      "www.practicatecnica.com",
      "practicatecnica.com",
      "*.supabase.co"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#0ea5e9",
      "sound": "beep.wav"
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#060c17",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0b1220"
    }
  }
}